1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0

BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "https://gitlab.com/virt-viewer/virt-viewer"
      VALUE "FileDescription", "ovworksViewer desktop client"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "@PACKAGE_STRING@"
      VALUE "LegalCopyright", "Copyright (C) 2007-2013 Red Hat, Inc."
      VALUE "OriginalFilename", "virt-viewer.exe"
      VALUE "ProductName", "ovworksViewer"
      VALUE "ProductVersion", "@VERSION@"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
2 ICON ICONDIR "/virt-viewer.ico"
/* CREATEPROCESS_MANIFEST_RESOURCE_ID must be 1 for Windows to apply the
 * requestedExecutionLevel and display the UAC consent dialog at launch. */
1 RT_MANIFEST MANIFESTDIR "/virt-viewer.manifest"
